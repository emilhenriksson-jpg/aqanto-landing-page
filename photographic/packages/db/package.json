{
  "name": "@photographic/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --emitDeclarationOnly --outDir dist",
    "migrate": "tsx src/migrate.ts",
    "reset": "tsx src/reset.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@photographic/agent": "workspace:*",
    "@photographic/core": "workspace:*",
    "pg": "^8.13.1",
    "@photographic/auth": "workspace:*",
    "@photographic/documents": "workspace:*",
    "@photographic/export": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
