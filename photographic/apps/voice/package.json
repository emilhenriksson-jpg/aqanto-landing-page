{
  "name": "@photographic/voice",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build && tsc -p tsconfig.server.json",
    "dev": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "serve": "node dist/node/server/index.js",
    "start": "pnpm run build && pnpm run serve"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@photographic/core": "workspace:*",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "jsdom": "^30.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.0",
    "vitest": "^2.1.8"
  }
}
