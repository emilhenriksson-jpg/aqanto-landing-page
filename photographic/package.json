{
  "name": "photographic",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "node scripts/run-suites.mjs",
    "test:unit": "node scripts/run-suites.mjs unit",
    "test:db": "node scripts/run-suites.mjs db",
    "test:e2e": "node scripts/run-suites.mjs e2e-postgres",
    "test:e2e:memory": "node scripts/run-suites.mjs e2e-memory",
    "check:test-doubles": "node scripts/check-test-doubles.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:prune": "eslint . --prune-suppressions",
    "db:migrate": "pnpm --filter @photographic/db run migrate",
    "db:reset": "pnpm --filter @photographic/db run reset",
    "db:seed": "pnpm --filter @photographic/db run seed",
    "dev": "pnpm --filter @photographic/rest run dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@photographic/connect": "workspace:*",
    "@photographic/db": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.8"
  }
}
